# Copy to backend/.env. Never put keys in the frontend.
JEV_API_KEY=
JEV_MODEL=jev-latest
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-terra
# Optional absolute paths; defaults resolve from the project, not the shell cwd.
# DATABASE_PATH=C:/path/to/factorymind.sqlite3
# MODEL_DIR=C:/path/to/ml/artifacts
PORT=5000
